{
    "name": "os2forms/os2forms_payment",
    "description": "OS2Forms payment",
    "license": "MIT",
    "type": "drupal-module",
    "authors": [
        {
            "name": "Jeppe Julius Krogh",
            "email": "kjej@aarhus.dk"
        }
    ],
    "require": {
        "php": "^8.1",
        "drupal/advancedqueue": "^1.0",
        "drupal/webform": "^6.1",
        "drush/drush": "^11 || ^12 || ^13",
        "symfony/options-resolver": "^5.4 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "drupal/coder": "^8.3",
        "ergebnis/composer-normalize": "^2.47",
        "mglaman/phpstan-drupal": "^2.0",
        "palantirnet/drupal-rector": "^1.0",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "ergebnis/composer-normalize": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "code-analysis": [
            "@code-analysis/drupal-check"
        ],
        "code-analysis/drupal-check": [
            "drupal-check --deprecations --analysis --exclude-dir=vendor *.* src"
        ],
        "coding-standards-apply": [
            "@coding-standards-apply/phpcbf"
        ],
        "coding-standards-apply/phpcbf": [
            "phpcbf --standard=phpcs.xml.dist"
        ],
        "coding-standards-check": [
            "@coding-standards-check/phpcs"
        ],
        "coding-standards-check/phpcs": [
            "phpcs --standard=phpcs.xml.dist"
        ],
        "test": [
            "phpunit tests"
        ]
    }
}
